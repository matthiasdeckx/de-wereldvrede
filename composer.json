{
  "name": "de-wereldvrede/site",
  "description": "Kirby site for De Wereldvrede",
  "type": "project",
  "keywords": [
    "kirby",
    "cms"
  ],
  "require": {
    "php": ">=8.0.0 <8.4",
    "getkirby/cms": "^5.2",
    "sylvainjule/kirby-multilist": "^1.1",
    "diverently/laravel-mix-kirby": "^1.4",
    "isaactopo/xmlsitemap": "^0.2.0"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ]
  }
}
